@page "/"
@using Tedd.TUI
@using Tedd.TUI.Platform.Blazor
@using Tedd.TUI.Platform.Blazor.Components

<PageTitle>Tedd.TUI Blazor Demo</PageTitle>

<h1>Tedd.TUI Blazor Demo</h1>

<p>
    Use keyboard (Arrows, Enter) or Mouse.
    <label>
        Render Mode:
        <select @bind="currentMode">
            <option value="@TuiRenderMode.Canvas">Canvas</option>
            <option value="@TuiRenderMode.Dom">DOM (Accessible)</option>
        </select>
    </label>
</p>

<TuiView Width="80" Height="25" Mode="@currentMode" @key="currentMode">
    <TuiBorder BorderColor="ConsoleColor.Cyan" BoxStyle="BoxStyle.Double" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalAlignment="VerticalAlignment.Stretch">
        <TuiStackPanel Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
            <TuiLabel Text="Hello from Blazor TUI!" Foreground="ConsoleColor.Green" HorizontalAlignment="HorizontalAlignment.Center" />

            <TuiLabel Text="@($"Counter: {counter}")" Foreground="ConsoleColor.White" HorizontalAlignment="HorizontalAlignment.Center" />

            <TuiButton Text="Click Me" OnClick="IncrementCount" HorizontalAlignment="HorizontalAlignment.Center" />

            <TuiButton Text="Reset" OnClick="ResetCount" BoxStyle="BoxStyle.Double" HorizontalAlignment="HorizontalAlignment.Center" />
        </TuiStackPanel>
    </TuiBorder>
</TuiView>

<div style="margin-top: 20px;">
    <p>External Counter: @counter</p>
</div>

@code {
    private int counter = 0;
    private TuiRenderMode currentMode = TuiRenderMode.Canvas;

    private void IncrementCount()
    {
        counter++;
    }

    private void ResetCount()
    {
        counter = 0;
    }

    protected override void OnInitialized()
    {
       
    }
}
