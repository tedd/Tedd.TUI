@page "/"
@* 
    NOTE TO AI: 
    When making changes to this file (Home.razor), please also update Programmatic.razor ("The Programmatic version") 
    to maintain feature parity between the programmatic and declarative approaches. 
*@
@using Tedd.TUI
@using Tedd.TUI.Platform.Blazor
@using Tedd.TUI.Platform.Blazor.Components

<PageTitle>Tedd.TUI Blazor Demo</PageTitle>

<h1>Tedd.TUI Blazor Demo</h1>
<p>
    This UI is built using Blazor components ("XAML-like"), feature-equivalent to the Programmatic version.
</p>

<!-- Pass the window instance so we can attach overlays (Dialogs) imperatively if needed -->
<TuiView Window="@window" Width="80" Height="25" Mode="@currentMode" @key="currentMode">
    <TuiStackPanel Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalAlignment="VerticalAlignment.Stretch">
        
        <!-- Menu Bar -->
        <TuiMenuBar HorizontalAlignment="HorizontalAlignment.Stretch">
            <TuiMenuItem Text="File">
                <TuiMenuItem Text="New" OnClick='() => Log("New Clicked")' />
                <TuiMenuItem Text="Open" OnClick='() => Log("Open Clicked")' />
                <TuiMenuItem Text="Exit" OnClick='() => Log("Exit Clicked")' />
            </TuiMenuItem>
            <TuiMenuItem Text="Edit">
                <TuiMenuItem Text="Cut" OnClick='() => Log("Cut Clicked")' />
                <TuiMenuItem Text="Copy" OnClick='() => Log("Copy Clicked")' />
                <TuiMenuItem Text="Paste" OnClick='() => Log("Paste Clicked")' />
            </TuiMenuItem>
             <TuiMenuItem Text="Help">
                <TuiMenuItem Text="About" OnClick='() => Log("About Clicked")' />
            </TuiMenuItem>
        </TuiMenuBar>

        <!-- Header -->
        <TuiBorder BoxStyle="BoxStyle.Double" HorizontalAlignment="HorizontalAlignment.Stretch">
             <TuiLabel Text="Tedd.TUI Demo Application (.NET 10)" Foreground="ConsoleColor.Cyan" />
        </TuiBorder>

        <!-- Mode Switcher -->
        <TuiStackPanel Orientation="Orientation.Horizontal">
            <TuiLabel Text="Render Mode: " />
            <TuiComboBox Items="@renderModes" @bind-SelectedItem="selectedRenderModeString" Width="15" />
        </TuiStackPanel>

        <!-- Main Tab Control -->

        <!-- Bifurcated Architecture -->
        <TuiDockPanel LastChildFill="true">
            <!-- Navigation Pane (Left) -->
            <TuiExpander Dock="Dock.Left" Header="Navigation" IsExpanded="true">
                <TuiTreeView SelectedItemChanged="OnNavSelected">
                    <TuiTreeViewItem Header="Controls" IsExpanded="true">
                        <TuiTreeViewItem Header="Form" IsSelected="true" />
                        <TuiTreeViewItem Header="Lists" />
                        <TuiTreeViewItem Header="Table" />
                        <TuiTreeViewItem Header="Scroll" />
                        <TuiTreeViewItem Header="Code" />
                        <TuiTreeViewItem Header="Markdown" />
                        <TuiTreeViewItem Header="DataGrid" />
                        <TuiTreeViewItem Header="Editor" />
                        <TuiTreeViewItem Header="ProgressBar" />
                    </TuiTreeViewItem>
                </TuiTreeView>
            </TuiExpander>

            <!-- Content Matrix (Center) -->
            <TuiTabControl Height="20" @bind-SelectedIndex="selectedTabIndex">

            
            <!-- Tab 1: Form -->
            <TuiTabItem Header="Form">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="Name:" />
                    <TuiTextBox Width="30" @bind-Text="formName" />
                    
                    <TuiLabel Text="Password:" />
                    <TuiTextBox Width="30" IsPassword="true" @bind-Text="formPass" />
                    
                    <TuiCheckBox Content="I agree to Terms & Conditions" @bind-IsChecked="isAgreed" />
                    
                    <TuiLabel Text="Gender:" />
                    <TuiStackPanel Orientation="Orientation.Horizontal">
                        <TuiRadioButton Content="Male" GroupName="Gender" @bind-IsChecked="isMale" />
                        <TuiRadioButton Content="Female" GroupName="Gender" @bind-IsChecked="isFemale" />
                        <TuiRadioButton Content="Other" GroupName="Gender" @bind-IsChecked="isOther" />
                    </TuiStackPanel>

                    <TuiLabel Text="Country:" />
                    <TuiComboBox Width="20" Items="@countries" @bind-SelectedItem="selectedCountry" />

                    <TuiLabel Text="--- Log ---" Foreground="ConsoleColor.DarkGray" />
                    <TuiListBox Width="80" Height="5" Items="@logItems" @bind-SelectedIndex="logIndex" />

                    <!-- Buttons -->
                    <TuiStackPanel Orientation="Orientation.Horizontal">
                        <TuiButton Text="Submit" BoxStyle="BoxStyle.Double" OnClick="SubmitForm" />
                        <TuiLabel Text="  " />
                        <TuiButton Text="Show Dialog" BoxStyle="BoxStyle.Single" OnClick="ShowDialog" />
                    </TuiStackPanel>
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 2: Lists -->
            <TuiTabItem Header="Lists">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="Items:" />
                    <!-- Generating static items for demo -->
                    <TuiListBox Width="40" Height="10" Items="@listItems" />
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 3: Table -->
            <TuiTabItem Header="Table">
                 <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="Table Control:" />
                    <TuiTable Width="60" Height="10" ShowHeader="true" 
                              PageSize="@pageSize" TotalRows="@totalRows" 
                              @bind-CurrentPage="currentPage" 
                              PageChanged="OnPageChanged">
                        <TuiTableColumn Header="ID" Width="5" />
                        <TuiTableColumn Header="Name" Width="*" />
                        <TuiTableColumn Header="Age" Width="Auto" />
                        <TuiTableColumn Header="Actions" Width="10" />
                        
                        @foreach(var item in currentTableRows)
                        {
                            <TuiTableRow>
                                <TuiLabel Text="@item.Id" /> 
                                <TuiLabel Text="@item.Name" /> 
                                <TuiLabel Text="@item.Age" /> 
                                @if(item.IsCheckable)
                                {
                                     <TuiCheckBox Content="Active" @bind-IsChecked="item.Checked" />
                                }
                                else
                                {
                                     <TuiLabel Text="@item.Action" />
                                }
                            </TuiTableRow>
                        }
                    </TuiTable>
                 </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 4: Scroll -->
            <TuiTabItem Header="Scroll">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="ScrollBars Demo" />
                    <TuiLabel Text="@scrollLabelText" />

                    <TuiLabel Text="Horizontal:" />
                    <TuiScrollBar Orientation="Orientation.Horizontal" Width="40" Minimum="0" Maximum="100" ViewportSize="20" Value="@hScrollValue" ValueChanged="OnHScrollChanged" />

                    <TuiLabel Text="Vertical:" />
                    <TuiScrollBar Orientation="Orientation.Vertical" Height="10" Minimum="0" Maximum="50" ViewportSize="10" Value="@vScrollValue" ValueChanged="OnVScrollChanged" />

                    <TuiLabel Text="ScrollViewer:" />
                    <TuiScrollViewer Width="40" Height="10" HorizontalScrollBarVisibility="true" VerticalScrollBarVisibility="true">
                        <TuiStackPanel Orientation="Orientation.Vertical">
                            @for (int i = 0; i < 20; i++)
                            {
                                <TuiButton Text="@($"Button {i} (Wide Content for Scroll)")" />
                            }
                        </TuiStackPanel>
                    </TuiScrollViewer>
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 5: Code -->
            <TuiTabItem Header="Code">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="Code Coloring Demo" />
                    <TuiScrollViewer Width="70" Height="15" VerticalScrollBarVisibility="true" HorizontalScrollBarVisibility="true">
                        <TuiComponentBase Component="@codeDoc" />
                    </TuiScrollViewer>
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 6: Markdown -->
            <TuiTabItem Header="Markdown">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="Markdown View:" />
                    <TuiScrollViewer Width="70" Height="15" VerticalScrollBarVisibility="true">
                        <TuiComponentBase Component="@mdView" />
                    </TuiScrollViewer>
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 7: DataGrid -->
            <TuiTabItem Header="DataGrid">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="DataGrid (Auto Generated Columns):" />
                    <TuiComponentBase Component="@dataGrid" />
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 8: Editor -->
            <TuiTabItem Header="Editor">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="Text Editor:" />
                    <TuiBorder BoxStyle="BoxStyle.Single" BorderColor="ConsoleColor.Cyan" Width="70" Height="15">
                        <TuiComponentBase Component="@textEditor" />
                    </TuiBorder>
                </TuiStackPanel>
            </TuiTabItem>

            <!-- Tab 9: ProgressBar -->
            <TuiTabItem Header="ProgressBar">
                <TuiStackPanel Orientation="Orientation.Vertical">
                    <TuiLabel Text="ProgressBar Permutations:" />
                    <TuiTabControl Width="70" Height="15">
                        <TuiTabItem Header="Percent">
                            <TuiStackPanel Orientation="Orientation.Vertical">
                                <TuiLabel Text="Percent Mode (Default)" />
                                <TuiProgressBar Width="40" Value="35" LabelMode="ProgressBarLabelMode.Percent" LabelPercentDecimals="0" />
                                <TuiProgressBar Width="40" Value="75" LabelMode="ProgressBarLabelMode.Percent" LabelPercentDecimals="1" ProgressColor="ConsoleColor.Blue" />
                            </TuiStackPanel>
                        </TuiTabItem>
                        <TuiTabItem Header="Text">
                            <TuiStackPanel Orientation="Orientation.Vertical">
                                <TuiLabel Text="Text Mode" />
                                <TuiProgressBar Width="40" Value="50" LabelMode="ProgressBarLabelMode.Text" LabelText="Loading..." ProgressColor="ConsoleColor.Red" LabelFilledColor="ConsoleColor.Yellow" />
                            </TuiStackPanel>
                        </TuiTabItem>
                        <TuiTabItem Header="None">
                            <TuiStackPanel Orientation="Orientation.Vertical">
                                <TuiLabel Text="None Mode" />
                                <TuiProgressBar Width="40" Value="60" LabelMode="ProgressBarLabelMode.None" ProgressColor="ConsoleColor.Green" />
                            </TuiStackPanel>
                        </TuiTabItem>
                    </TuiTabControl>
                </TuiStackPanel>
            </TuiTabItem>

        </TuiTabControl>
        </TuiDockPanel>

    </TuiStackPanel>
</TuiView>

@code {
    private TuiWindow window = new TuiWindow();
    private TuiRenderMode currentMode = TuiRenderMode.Canvas;
    

    private int selectedTabIndex = 0;

    private void OnNavSelected(object? selectedItem)
    {
        if (selectedItem is TreeViewItem tvi && tvi.Header is string header)
        {
            switch (header)
            {
                case "Form": selectedTabIndex = 0; break;
                case "Lists": selectedTabIndex = 1; break;
                case "Table": selectedTabIndex = 2; break;
                case "Scroll": selectedTabIndex = 3; break;
                case "Code": selectedTabIndex = 4; break;
                case "Markdown": selectedTabIndex = 5; break;
                case "DataGrid": selectedTabIndex = 6; break;
                case "Editor": selectedTabIndex = 7; break;
                case "ProgressBar": selectedTabIndex = 8; break;
            }
            StateHasChanged();
        }
    }

    // Render Mode Logic
    private List<string> renderModes = new List<string> { "Canvas", "DOM" };
    private string? selectedRenderModeString
    {
        get => currentMode.ToString();
        set
        {
            if (Enum.TryParse<TuiRenderMode>(value, true, out var mode))
            {
                if (currentMode != mode)
                {
                    currentMode = mode;
                    StateHasChanged();
                }
            }
        }
    }

    // Form Data
    private string formName = "John Doe";
    private string formPass = "secret";
    private bool isAgreed = false;
    private bool isMale = true;
    private bool isFemale = false; 
    private bool isOther = false;
    private List<string> countries = new() { "USA", "Canada", "UK", "Germany", "France", "Spain" };
    private string? selectedCountry = "USA";

    // Log Logic
    private List<string> logItems = new();
    private int logIndex = -1;

    private void Log(string message)
    {
        logItems.Add(message);
        logIndex = logItems.Count - 1; // Auto-scroll
        StateHasChanged();
    }

    private void SubmitForm()
    {
        Log($"Form Submitted: {formName} / {selectedCountry}");
    }

    // Dialog Logic
    private void ShowDialog()
    {
        var dialog = new DialogBox
        {
            Title = "Welcome",
            Width = 40,
            Height = 10,
            BoxStyle = BoxStyle.Double,
            BackgroundColor = ConsoleColor.DarkBlue,
            TitleColor = ConsoleColor.Yellow,
            BorderColor = ConsoleColor.White
        };

        var dialogStack = new StackPanel { Orientation = Orientation.Vertical };
        dialogStack.AddChild(new TextBlock { Text = "This is a modal dialog box.", Foreground = ConsoleColor.White });
        dialogStack.AddChild(new TextBlock { Text = "You can put any controls here.", Foreground = ConsoleColor.Gray });

        var btnClose1 = new Button { Content = "Close", BoxStyle = BoxStyle.Single };
        btnClose1.Click += (sender, args) => { dialog.Hide(); StateHasChanged(); };
        var btnClose2 = new Button { Content = "Close", BoxStyle = BoxStyle.Single };
        btnClose2.Click += (sender, args) => { dialog.Hide(); StateHasChanged(); };

        var btnContainer = new StackPanel { Orientation = Orientation.Horizontal };
        btnContainer.AddChild(new TextBlock { Text = "   " });
        btnContainer.AddChild(btnClose1);
        btnContainer.AddChild(btnClose2);

        dialogStack.AddChild(new TextBlock { Text = " " });
        dialogStack.AddChild(btnContainer);

        dialog.Content = dialogStack;

        // Use the window instance to set overlay
        window.PushOverlay(dialog);
        dialog.Show();
        StateHasChanged();
    }

    // Lists Tab Data
    private List<string> listItems = Enumerable.Range(1, 20).Select(i => $"Item {i}").ToList();

    // Table Logic
    private class TableItem
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Age { get; set; }
        public string Action { get; set; }
        public bool IsCheckable { get; set; }
        public bool Checked { get; set; } = true;
    }

    private List<TableItem> allTableItems = new();
    private List<TableItem> currentTableRows = new();
    private int pageSize = 5;
    private int totalRows = 0;
    private int currentPage = 0;

    // Scroll Data
    private int hScrollValue = 30;
    private int vScrollValue = 0;
    private string scrollLabelText = "H: 30, V: 0";

    private void OnHScrollChanged(int val)
    {
        hScrollValue = val;
        scrollLabelText = $"H: {hScrollValue}, V: {vScrollValue}";
        StateHasChanged();
    }

    private void OnVScrollChanged(int val)
    {
        vScrollValue = val;
        scrollLabelText = $"H: {hScrollValue}, V: {vScrollValue}";
        StateHasChanged();
    }

    // Code Data
    private Tedd.TUI.CodeColoring.CodeDocument codeDoc = new Tedd.TUI.CodeColoring.CodeDocument();

    // Markdown Data
    private Tedd.TUI.Markdown.MarkdownView mdView = new Tedd.TUI.Markdown.MarkdownView();

    // DataGrid Data
    private Tedd.TUI.DataGrid dataGrid = new Tedd.TUI.DataGrid
    {
        Width = 60,
        Height = 10,
        ShowHeader = true,
        PageSize = 5,
        AutoGenerateColumns = true,
        ShowBorder = true,
        BorderStyle = BoxStyle.Single
    };

    public class Person
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Age { get; set; }
        public string Role { get; set; } = string.Empty;
    }

    // Editor Data
    private Tedd.TUI.TextEditor textEditor = new Tedd.TUI.TextEditor { Width = -1, Height = -1 };

    protected override void OnInitialized()
    {
        // Populate Data
        allTableItems.Add(new TableItem { Id = "10", Name = "Alice", Age = "30", Action = "Edit" });
        allTableItems.Add(new TableItem { Id = "2", Name = "Bob", Age = "25", Action = "Edit" });
        allTableItems.Add(new TableItem { Id = "1", Name = "Charlie", Age = "35", Action = "Edit" });
        allTableItems.Add(new TableItem { Id = "20", Name = "David", Age = "40", IsCheckable = true });
        allTableItems.Add(new TableItem { Id = "3", Name = "Eve", Age = "22", Action = "Edit" });
        
        for (int i = 1; i <= 20; i++)
        {
            allTableItems.Add(new TableItem { Id = $"{100+i}", Name = $"User {i}", Age = $"{20 + (i%30)}", Action = "View" });
        }
        
        totalRows = allTableItems.Count;
        LoadPage(0);

        // Init Code
        string sampleCode = @"using System;

public class Test
{
    public void Method()
    {
        Console.WriteLine(""Hello World"");
        int x = 10;
        if (x > 5)
        {
            return;
        }
    }
}";
        codeDoc.SetCode(sampleCode, "csharp");

        // Init Markdown
        string mdText = @"# Markdown Demo

This is a **bold** text and *italic* text.
Here is a [Link](http://example.com) and an ![Image](img.png).

## Lists

- Item 1
- Item 2 with **bold**
- Item 3

## Code

```csharp
public void Hello() {
    Console.WriteLine(""World"");
}
```

## Table

| ID | Name |
|---|---|
| 1 | Alice |
| 2 | Bob |

> This is a quote.
";
        mdView.Text = mdText;

        // Init DataGrid
        var people = new List<Person>
        {
            new Person { Id = 1, Name = "Alice", Age = 30, Role = "Dev" },
            new Person { Id = 2, Name = "Bob", Age = 25, Role = "QA" },
            new Person { Id = 3, Name = "Charlie", Age = 35, Role = "Manager" },
            new Person { Id = 4, Name = "Dave", Age = 40, Role = "Dev" },
            new Person { Id = 5, Name = "Eve", Age = 22, Role = "Intern" },
            new Person { Id = 6, Name = "Frank", Age = 28, Role = "Dev" },
        };
        dataGrid.ItemsSource = people;
    }

    private void OnPageChanged()
    {
        LoadPage(currentPage);
    }

    private void LoadPage(int page)
    {
        // Assuming page is already updated in currentPage binding before this call?
        // Actually binding updates property then fires callback? 
        // Or callback fires then property updates? 
        // Blazor convention: EventCallback update logic usually handles it.
        // We set currentTableRows.
        
        int start = page * pageSize;
        currentTableRows = allTableItems.Skip(start).Take(pageSize).ToList();
        StateHasChanged();
    }
}
