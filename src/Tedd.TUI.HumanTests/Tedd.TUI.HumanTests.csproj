<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tedd.TUI\Tedd.TUI.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Platform.Console\Tedd.TUI.Platform.Console.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Platform.WindowsTerminal\Tedd.TUI.Platform.WindowsTerminal.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Platform.LinuxTerminal\Tedd.TUI.Platform.LinuxTerminal.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Platform.Avalonia\Tedd.TUI.Platform.Avalonia.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Platform.Skia\Tedd.TUI.Platform.Skia.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Platform.Sdl2\Tedd.TUI.Platform.Sdl2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop windowing backends + theme for the Avalonia render target. -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On Windows the exe targets net10.0-windows so it can also host the WPF render
         target; elsewhere it stays a plain net10.0 console app. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows</TargetFramework>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\Tedd.TUI.Platform.Wpf\Tedd.TUI.Platform.Wpf.csproj" />
  </ItemGroup>

</Project>
