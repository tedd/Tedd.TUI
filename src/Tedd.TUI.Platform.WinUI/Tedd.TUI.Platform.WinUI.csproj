<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <IsPackable>true</IsPackable>
    <Description>WinUI 3 host for Tedd.TUI: TuiHostControl renders the TUI cell grid via SkiaSharp in Windows App SDK applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="4.150.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedd.TUI\Tedd.TUI.csproj" />
    <ProjectReference Include="..\Tedd.TUI.Surface.Skia\Tedd.TUI.Surface.Skia.csproj" />
  </ItemGroup>

</Project>
