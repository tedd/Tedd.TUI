<TuiWindow>
  <StackPanel Orientation="Vertical">

    <!-- Menu Bar -->
    <MenuBar>
      <MenuItem>
         <MenuItem.Header><TextBlock Text="File " Foreground="Black"/></MenuItem.Header>
         <MenuItem.Items>
            <MenuItem Command="OnNewClick">
                <MenuItem.Header><TextBlock Text="New " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
            <MenuItem Command="OnOpenClick">
                <MenuItem.Header><TextBlock Text="Open " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
            <MenuItem Command="OnExitClick">
                <MenuItem.Header><TextBlock Text="Exit " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
         </MenuItem.Items>
      </MenuItem>
      <MenuItem>
         <MenuItem.Header><TextBlock Text="Edit " Foreground="Black"/></MenuItem.Header>
         <MenuItem.Items>
            <MenuItem Command="OnCutClick">
                <MenuItem.Header><TextBlock Text="Cut " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
            <MenuItem Command="OnCopyClick">
                <MenuItem.Header><TextBlock Text="Copy " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
            <MenuItem Command="OnPasteClick">
                <MenuItem.Header><TextBlock Text="Paste " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
         </MenuItem.Items>
      </MenuItem>
       <MenuItem>
         <MenuItem.Header><TextBlock Text="Help " Foreground="Black"/></MenuItem.Header>
         <MenuItem.Items>
            <MenuItem Command="OnAboutClick">
                <MenuItem.Header><TextBlock Text="About " Foreground="Black"/></MenuItem.Header>
            </MenuItem>
         </MenuItem.Items>
      </MenuItem>
    </MenuBar>

    <!-- Header -->
    <Border BoxStyle="Double">
       <TextBlock Text="Tedd.TUI Demo Application (XAML)" Foreground="Cyan"/>
    </Border>

    <!-- Mode Switcher -->
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="Render Mode: " />
        <ComboBox Name="RenderModeCombo" Width="15" />
    </StackPanel>

    <!-- Tabs -->

    <!-- Bifurcated Architecture -->
    <DockPanel LastChildFill="True">
        <!-- Navigation Pane (Left) -->
        <Expander Dock="Left" Header="Navigation" IsExpanded="True" Width="20">
            <TreeView Name="NavTree">
                <TreeViewItem Header="Controls" IsExpanded="True">
                    <TreeViewItem Header="Form" IsSelected="True" />
                    <TreeViewItem Header="Lists" />
                    <TreeViewItem Header="Table" />
                    <TreeViewItem Header="Scroll" />
                    <TreeViewItem Header="Code" />
                    <TreeViewItem Header="Markdown" />
                    <TreeViewItem Header="DataGrid" />
                    <TreeViewItem Header="Editor" />
                    <TreeViewItem Header="ProgressBar" />
                    <TreeViewItem Header="Layouts" />
                </TreeViewItem>
            </TreeView>
        </Expander>

        <!-- Content Matrix (Center) -->
        <TabControl Name="MainTabs" Height="20">


       <!-- Tab 1: Form -->
       <TabItem Header="Form">
          <StackPanel Orientation="Vertical">
             <TextBlock Text="Name:"/>
             <TextBox Name="NameBox" Width="30" Text="John Doe"/>

             <TextBlock Text="Password:"/>
             <PasswordBox Name="PassBox" Width="30" Password="secret"/>

             <TextBlock Text="Volume:"/>
             <Slider Name="FormSlider" Minimum="0" Maximum="100" Value="50" Width="20"/>
             <TextBlock Name="VolumeLabel" Text="Current Volume: 50"/>

             <CheckBox Name="TermsCheck" Content="I agree to Terms &amp; Conditions"/>

             <TextBlock Text="Gender:"/>
             <StackPanel Orientation="Horizontal">
                <RadioButton Content="Male" GroupName="Gender" IsChecked="True"/>
                <RadioButton Content="Female" GroupName="Gender"/>
                <RadioButton Content="Other" GroupName="Gender"/>
             </StackPanel>

             <TextBlock Text="Country:"/>
             <ComboBox Name="CountryCombo" Width="20"/>

             <StackPanel Orientation="Horizontal">
                <Button Content="Submit" BoxStyle="Double" Click="OnSubmit"/>
                <TextBlock Text="  "/>
                <Button Content="Show Dialog" BoxStyle="Single" Click="OnShowDialog"/>
             </StackPanel>
          </StackPanel>
       </TabItem>

       <!-- Tab 2: Lists -->
       <TabItem Header="Lists">
           <StackPanel Orientation="Vertical">
              <TextBlock Text="Items:"/>
              <ListBox Name="SimpleList" Width="40" Height="10"/>
           </StackPanel>
       </TabItem>

       <!-- Tab 3: Table -->
       <TabItem Header="Table">
          <StackPanel Orientation="Vertical">
              <TextBlock Text="Table Control:"/>
              <Table Name="DemoTable" Width="60" Height="10" ShowHeader="True" PageSize="5">
                 <Table.Columns>
                    <TableColumn Header="ID" Width="5"/>
                    <TableColumn Header="Name" Width="*"/>
                    <TableColumn Header="Age" Width="Auto"/>
                    <TableColumn Header="Actions" Width="15"/>
                 </Table.Columns>
              </Table>
          </StackPanel>
       </TabItem>

       <!-- Tab 4: Scroll -->
       <TabItem Header="Scroll">
           <StackPanel Orientation="Vertical">
               <TextBlock Text="ScrollBars Demo"/>
               <TextBlock Name="ScrollLabel" Text="H: 0, V: 0"/>

               <TextBlock Text="Horizontal:"/>
               <ScrollBar Name="HScroll" Orientation="Horizontal" Width="40" Minimum="0" Maximum="100" ViewportSize="20" Value="30"/>

               <TextBlock Text="Vertical:"/>
               <ScrollBar Name="VScroll" Orientation="Vertical" Height="10" Minimum="0" Maximum="50" ViewportSize="10"/>

               <TextBlock Text="ScrollViewer:"/>
               <ScrollViewer Width="40" Height="10" HorizontalScrollBarVisibility="True" VerticalScrollBarVisibility="True">
                   <StackPanel Orientation="Vertical" Name="ScrollStackPanel"/>
               </ScrollViewer>
           </StackPanel>
       </TabItem>

       <!-- Tab 5: Code -->
       <TabItem Header="Code">
          <StackPanel Orientation="Vertical">
              <TextBlock Text="Code Coloring Demo"/>
              <ScrollViewer Width="70" Height="15" VerticalScrollBarVisibility="True" HorizontalScrollBarVisibility="True">
                  <CodeDocument Name="CodeDoc"/>
              </ScrollViewer>
          </StackPanel>
       </TabItem>

       <!-- Tab 6: Markdown -->
       <TabItem Header="Markdown">
          <StackPanel Orientation="Vertical">
              <TextBlock Text="Markdown View:"/>
              <ScrollViewer Width="70" Height="15" VerticalScrollBarVisibility="True">
                  <MarkdownView Name="MdView"/>
              </ScrollViewer>
          </StackPanel>
       </TabItem>

       <!-- Tab 7: DataGrid -->
       <TabItem Header="DataGrid">
          <StackPanel Orientation="Vertical">
              <TextBlock Text="DataGrid (Auto Generated Columns):"/>
              <DataGrid Name="DemoDataGrid" Width="60" Height="10" ShowHeader="True" PageSize="5" AutoGenerateColumns="True" ShowBorder="True" BorderStyle="Single"/>
          </StackPanel>
       </TabItem>

       <!-- Tab 8: Editor -->
       <TabItem Header="Editor">
           <StackPanel Orientation="Vertical">
               <TextBlock Text="Text Editor:"/>
               <Border BoxStyle="Single" BorderColor="Cyan" Width="70" Height="15">
                   <TextEditor Name="EditorBox" Width="-1" Height="-1" />
               </Border>
           </StackPanel>
       </TabItem>

       <!-- Tab 9: ProgressBar -->
       <TabItem Header="ProgressBar">
           <StackPanel Orientation="Vertical">
               <TextBlock Text="ProgressBar Permutations:"/>
               <TabControl Width="70" Height="15">
                   <TabItem Header="Percent">
                       <StackPanel Orientation="Vertical">
                           <TextBlock Text="Percent Mode"/>
                           <ProgressBar Width="40" Value="35" LabelMode="Percent" LabelPercentDecimals="0" />
                           <ProgressBar Width="40" Value="75" LabelMode="Percent" LabelPercentDecimals="1" ProgressColor="Blue" />
                       </StackPanel>
                   </TabItem>
                   <TabItem Header="Text">
                       <StackPanel Orientation="Vertical">
                           <TextBlock Text="Text Mode"/>
                           <ProgressBar Width="40" Value="50" LabelMode="Text" LabelText="Loading..." ProgressColor="Red" LabelFilledColor="Yellow" />
                       </StackPanel>
                   </TabItem>
                   <TabItem Header="None">
                       <StackPanel Orientation="Vertical">
                           <TextBlock Text="None Mode"/>
                           <ProgressBar Width="40" Value="60" LabelMode="None" ProgressColor="Green" />
                       </StackPanel>
                   </TabItem>
               </TabControl>
           </StackPanel>
       </TabItem>

       <!-- Tab 10: Layouts -->
       <TabItem Header="Layouts">
           <StackPanel Orientation="Vertical">
               <TextBlock Text="Layout Panels:"/>
               <TabControl Width="70" Height="15">
                   <TabItem Header="Grid">
                       <StackPanel Orientation="Vertical">
                           <TextBlock Text="Grid Layout"/>
                           <Grid Width="60" Height="10">
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="*"/>
                                   <RowDefinition Height="*"/>
                               </Grid.RowDefinitions>
                               <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="*"/>
                                   <ColumnDefinition Width="*"/>
                                   <ColumnDefinition Width="*"/>
                               </Grid.ColumnDefinitions>
                               <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="0,0 Span 2"/>
                               <Button Grid.Row="0" Grid.Column="2" Content="0,2"/>
                               <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="1,0 Span 3"/>
                           </Grid>
                       </StackPanel>
                   </TabItem>
                   <TabItem Header="Wrap">
                       <StackPanel Orientation="Vertical">
                           <TextBlock Text="WrapPanel Layout"/>
                           <WrapPanel Width="50" Height="10">
                               <Button Content="Btn 0"/>
                               <Button Content="Btn 1"/>
                               <Button Content="Btn 2"/>
                               <Button Content="Btn 3"/>
                               <Button Content="Btn 4"/>
                               <Button Content="Btn 5"/>
                               <Button Content="Btn 6"/>
                               <Button Content="Btn 7"/>
                               <Button Content="Btn 8"/>
                               <Button Content="Btn 9"/>
                               <Button Content="Btn 10"/>
                               <Button Content="Btn 11"/>
                               <Button Content="Btn 12"/>
                               <Button Content="Btn 13"/>
                               <Button Content="Btn 14"/>
                           </WrapPanel>
                       </StackPanel>
                   </TabItem>
                   <TabItem Header="Group">
                       <StackPanel Orientation="Vertical">
                           <TextBlock Text="GroupBox Layout"/>
                           <GroupBox Header="Settings" Width="40" Height="10">
                               <StackPanel Orientation="Vertical">
                                   <CheckBox Content="Enable Feature A"/>
                                   <CheckBox Content="Enable Feature B"/>
                               </StackPanel>
                           </GroupBox>
                       </StackPanel>
                   </TabItem>
               </TabControl>
           </StackPanel>
       </TabItem>

    </TabControl>
    </DockPanel>

    <TextBlock Text="--- Log ---" Foreground="DarkGray"/>
    <ListBox Name="LogBox" Width="80" Height="5"/>

  </StackPanel>
</TuiWindow>
