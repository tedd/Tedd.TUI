@using Tedd.TUI
@using Tedd.TUI.Platform.Blazor
@implements IDisposable

@using System.Text
@using System.Text
@{
    var cw = Renderer?.CharWidth ?? 10;
    var ch = Renderer?.CharHeight ?? 18;
}
<div class="tui-root-container" style="position: relative; width: @(Width * cw)px; height: @(Height * ch)px; background-color: black; user-select: none;">
    @if (Renderer?.Layers != null)
    {
        @foreach (var layer in Renderer.Layers)
        {
            <div class="tui-layer" style="position: absolute; left: @(layer.X * cw)px; top: @(layer.Y * ch)px; z-index: @layer.ZIndex; font-family: 'Consolas', monospace; line-height: @(ch)px; font-size: 16px; white-space: pre; color: white; pointer-events: none;">
                @{
                    var buffer = layer.Buffer;
                    for (int y = 0; y < buffer.Height; y++)
                    {
                        <div class="tui-row" style="height: @(ch)px;">
                            @{
                                int x = 0;
                                while (x < buffer.Width)
                                {
                                    var startCell = buffer.GetPixel(x, y);
                                    var fg = startCell.Foreground;
                                    var bg = startCell.Background;
                                    _sb.Clear();

                                    while (x < buffer.Width)
                                    {
                                        var current = buffer.GetPixel(x, y);
                                        if (current.Foreground != fg || current.Background != bg)
                                            break;
                                        
                                        _sb.Append(current.Character);
                                        x++;
                                    }
                                    
                                    <span style="display:inline-block; height: @(ch)px; color: @ToHtmlColor(fg); background-color: @ToHtmlColor(bg);">@_sb.ToString()</span>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public DomRenderer? Renderer { get; set; }
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }

    private VirtualBuffer? _buffer;
    private DomRenderer? _previousRenderer;
    private StringBuilder _sb = new StringBuilder();

    protected override void OnInitialized()
    {
    }

    protected override void OnParametersSet()
    {
        if (Renderer != _previousRenderer)
        {
            if (_previousRenderer != null)
            {
                _previousRenderer.OnRender -= OnRender;
            }

            _previousRenderer = Renderer;

            if (Renderer != null)
            {
                Renderer.OnRender += OnRender;
                
                // Initial update if buffer exists
                if (Renderer.CurrentBuffer != null)
                {
                    OnRender();
                }
            }
        }
    }

    private void OnRender()
    {
        _buffer = Renderer?.CurrentBuffer;
        StateHasChanged();
    }

    private string ToHtmlColor(ConsoleColor color)
    {
        return color switch
        {
            ConsoleColor.Black => "#000000",
            ConsoleColor.DarkBlue => "#00008B",
            ConsoleColor.DarkGreen => "#006400",
            ConsoleColor.DarkCyan => "#008B8B",
            ConsoleColor.DarkRed => "#8B0000",
            ConsoleColor.DarkMagenta => "#8B008B",
            ConsoleColor.DarkYellow => "#808000",
            ConsoleColor.Gray => "#C0C0C0",
            ConsoleColor.DarkGray => "#808080",
            ConsoleColor.Blue => "#0000FF",
            ConsoleColor.Green => "#00FF00",
            ConsoleColor.Cyan => "#00FFFF",
            ConsoleColor.Red => "#FF0000",
            ConsoleColor.Magenta => "#FF00FF",
            ConsoleColor.Yellow => "#FFFF00",
            ConsoleColor.White => "#FFFFFF",
            _ => "#000000"
        };
    }

    public void Dispose()
    {
        if (Renderer != null)
        {
            Renderer.OnRender -= OnRender;
        }
    }
}
