@using System
@using System.Collections.Generic
@using Tedd.TUI
@using Tedd.TUI.Platform.Blazor
@implements IDisposable

@{
    var cw = Renderer?.CharWidth ?? 10;
    var ch = Renderer?.CharHeight ?? 18;
    _markup.BeginFrame();
}
<div class="tui-root-container" style="@DomGridMarkup.RootStyle(Width, Height, cw, ch)">
    @if (Renderer?.Layers != null)
    {
        foreach (var layer in Renderer.Layers)
        {
            <div class="tui-layer" style="@DomGridMarkup.LayerStyle(layer.X, layer.Y, layer.ZIndex, cw, ch)">
                @BufferContent(layer.Buffer, cw, ch)
            </div>
        }
    }
</div>

@code {
    [Parameter] public DomRenderer? Renderer { get; set; }
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }

    private DomRenderer? _previousRenderer;

    // All markup generation lives here so it can be unit-tested and reused by the prerender
    // path. The instance is per-grid because it owns the row and image caches.
    private readonly DomGridMarkup _markup = new();

    /// <summary>
    /// Emits one buffer: its rows, its bitmap placements, then any pre-rendered scroll panes,
    /// recursing into each pane's content buffer.
    /// </summary>
    /// <remarks>
    /// <para>Rows stay individual <c>MarkupString</c> nodes rather than one string per buffer.
    /// Handing Blazor the same string instance for an unchanged row lets its diff skip that row,
    /// so a frame only patches rows whose cells actually changed — a full-grid repaint is what
    /// makes large grids expensive.</para>
    /// <para>The pane wrappers are real elements, not markup strings, so their children nest
    /// inside them. Everything is emitted inline in this one component, which is what makes the
    /// scope counter deterministic: the traversal runs synchronously in a fixed order, so a given
    /// structural position gets the same scope id every frame and its row cache keeps hitting.</para>
    /// </remarks>
    private RenderFragment BufferContent(VirtualBuffer buffer, int cw, int ch) => builder =>
    {
        int scope = _markup.NextScope();
        int seq = 0;

        for (int y = 0; y < buffer.Height; y++)
        {
            builder.AddContent(seq++, (MarkupString)_markup.GetRowHtml(scope, y, buffer, ch));
        }

        if (buffer.Graphics != null)
        {
            foreach (var g in buffer.Graphics)
            {
                var src = _markup.GetImageSrc(g);
                if (!string.IsNullOrEmpty(src))
                {
                    builder.AddContent(seq++, (MarkupString)DomGridMarkup.ImageHtml(g, src, cw, ch));
                }
            }
        }

        if (buffer.ScrollPanes != null)
        {
            foreach (var pane in buffer.ScrollPanes)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "tui-scroll-pane");
                builder.AddAttribute(seq++, "style", DomGridMarkup.PaneStyle(pane, cw, ch));

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "tui-scroll-content");
                builder.AddAttribute(seq++, "style", DomGridMarkup.PaneContentStyle(pane, cw, ch));

                // AddContent invokes the fragment straight into this builder, so the traversal
                // stays synchronous and in order -- which is what the scope counter relies on.
                builder.AddContent(seq++, BufferContent(pane.Content, cw, ch));

                builder.CloseElement();
                builder.CloseElement();
            }
        }
    };

    protected override void OnParametersSet()
    {
        if (Renderer != _previousRenderer)
        {
            if (_previousRenderer != null)
            {
                _previousRenderer.OnRender -= OnRender;
            }

            _previousRenderer = Renderer;

            if (Renderer != null)
            {
                Renderer.OnRender += OnRender;

                // Initial update if buffer exists
                if (Renderer.CurrentBuffer != null)
                {
                    OnRender();
                }
            }
        }
    }

    private void OnRender()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (Renderer != null)
        {
            Renderer.OnRender -= OnRender;
        }
    }
}
