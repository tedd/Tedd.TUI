@using Microsoft.JSInterop
@using Tedd.TUI
@using Tedd.TUI.Platform.Blazor
@using Tedd.TUI.Platform.Blazor.Components
@implements ITuiContainer
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@ContainerId" tabindex="0" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" @onmousedown='OnMouseDownInternal' @onwheel="OnWheel" style="outline:none; display: inline-block;">
    @if (Mode == TuiRenderMode.Canvas)
    {
        <canvas id="@CanvasId"></canvas>
    }
    else
    {
        <TuiDomGrid Renderer="@(_renderer as DomRenderer)" Width="@Width" Height="@Height" />
    }
</div>

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Width { get; set; } = 80;
    [Parameter] public int Height { get; set; } = 25;
    [Parameter] public TuiWindow? Window { get; set; }
    [Parameter] public TuiRenderMode Mode { get; set; } = TuiRenderMode.Canvas;

    /// <summary>
    /// In <see cref="TuiRenderMode.Dom"/>, whether scrollable regions emit their whole content
    /// into the DOM behind a clipped, CSS-translated box instead of only the visible rows.
    /// Defaults to true; an individual viewer opts out via
    /// <see cref="ScrollViewer.SetPrerenderContent"/>.
    /// </summary>
    /// <remarks>
    /// Off-screen rows then survive into the document, so find-in-page, text extraction and
    /// prerendered HTML see the whole content and scrolling becomes a transform rather than a
    /// re-render. The cost is that node count scales with content extent rather than viewport
    /// area — turn it off for viewers over very large content. Ignored in
    /// <see cref="TuiRenderMode.Canvas"/>, which has no sub-region to clip.
    /// </remarks>
    [Parameter] public bool PrerenderScrollContent { get; set; } = true;

    public string CanvasId { get; } = "tui_c_" + Guid.NewGuid().ToString("N");
    public string ContainerId { get; } = "tui_v_" + Guid.NewGuid().ToString("N");

    private BlazorTuiApp? _app;
    private TuiWindow? _internalWindow;
    private IRendererAsync? _renderer;

    private TuiRenderMode _currentMode;
    private bool _modeChanged;
    private bool _appStarted;

    public TuiWindow? CurrentWindow => Window ?? _internalWindow;

    protected override void OnInitialized()
    {
        if (Window == null)
        {
            _internalWindow = new TuiWindow();
        }
        _currentMode = Mode;

        // Prerender: OnAfterRender never runs during static rendering, so without a frame
        // produced here the prerendered markup is an empty container and a crawler sees nothing.
        // Canvas has nothing to emit server-side (it paints through JS), so only DOM takes this.
        if (Mode == TuiRenderMode.Dom)
        {
            CreateApp();
            _app?.RenderStaticFrame(Width, Height);
        }
    }

    protected override void OnParametersSet()
    {
        if (Mode != _currentMode)
        {
            _currentMode = Mode;
            _modeChanged = true;
        }

        if (_app != null)
        {
            _app.PrerenderScrollContent = Mode == TuiRenderMode.Dom && PrerenderScrollContent;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _modeChanged)
        {
            if (_modeChanged)
            {
                // The surface changed underneath us: the old renderer targets the wrong element.
                _modeChanged = false;
                CreateApp();
            }

            await StartAppAsync();

            if (_objRef == null) _objRef = DotNetObjectReference.Create(this);

            // Hand JS the same cell metrics the renderer resolved. When JS guesses its own
            // (its defaults) the grid it asks for doesn't match the grid we draw: too few
            // columns leaves dead space, too many pushes the right-hand scrollbar column
            // outside the viewport where it can't be seen or clicked.
            int cellW = _app?.InputManager.CharWidth ?? 10;
            int cellH = _app?.InputManager.CharHeight ?? 18;
            await JS.InvokeVoidAsync("tuiInterop.listenForResize", _objRef, CanvasId, cellW, cellH);
        }
    }

    /// <summary>
    /// Builds the renderer and app for the current <see cref="Mode"/>, replacing any existing
    /// pair. Does not start the render loop — see <see cref="StartAppAsync"/>.
    /// </summary>
    private void CreateApp()
    {
        if (_app != null)
        {
            _app.Dispose();
            _app = null;
            _appStarted = false;
        }

        var win = CurrentWindow;
        if (win == null) return;

        _renderer = Mode == TuiRenderMode.Canvas
            ? new BlazorRenderer(JS, CanvasId)
            : (IRendererAsync)new DomRenderer(JS);

        _app = new BlazorTuiApp(win, _renderer)
        {
            PrerenderScrollContent = Mode == TuiRenderMode.Dom && PrerenderScrollContent,
        };
    }

    private async Task StartAppAsync()
    {
        // DOM mode already built the pair in OnInitialized to prerender a frame; reuse it so the
        // markup the browser hydrates is the markup that was prerendered.
        if (_app == null) CreateApp();
        if (_app == null) return;

        await _app.StartAsync(Width, Height);
        _appStarted = true;

        // If DOM mode, we need to trigger a re-render to pass the renderer reference to TuiDomGrid
        if (Mode == TuiRenderMode.Dom)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void AddChild(UIElement child)
    {
        var win = CurrentWindow;
        if (win != null)
        {
            win.Content = child;

            // Razor-authored children register from their own OnInitialized, which runs after
            // this view first rendered — so the frame produced there saw an empty window. Redo it
            // now that content exists; a prerender pass never reaches OnAfterRender and would
            // otherwise emit a blank grid. Once the loop owns rendering this is redundant.
            if (!_appStarted && Mode == TuiRenderMode.Dom)
            {
                _app?.RenderStaticFrame(Width, Height);
            }
        }
    }
    
    [JSInvokable]
    public void OnBrowserResize(int cols, int rows)
    {
        if (Width != cols || Height != rows)
        {
            Width = cols;
            Height = rows;
            _app?.OnResize(cols, rows);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private DotNetObjectReference<TuiView>? _objRef;

    private void OnKeyDown(KeyboardEventArgs e) => _app?.InputManager.QueueKey(e, true);
    private void OnKeyUp(KeyboardEventArgs e) => _app?.InputManager.QueueKey(e, false);

    private void OnWheel(WheelEventArgs e) => _app?.InputManager.QueueWheel(e);
    
    private void OnMouseDownInternal(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Start global tracking for drag
        if (_objRef != null)
        {
            // Fire and forget or sync?
            // JS interop is async usually.
            // But we process this event now.
            JS.InvokeVoidAsync("tuiInterop.startGlobalDrag", _objRef, ContainerId);
        }
        _app?.InputManager.QueueMouse(e, "mousedown");
    }

    [JSInvokable]
    public void OnGlobalMouse(string type, double x, double y)
    {
        // Construct a MouseEventArgs manually
        // Note: Blazor's MouseEventArgs has many fields. We populate essential ones.
        // x and y are relative to container (thanks to JS logic).
        var args = new Microsoft.AspNetCore.Components.Web.MouseEventArgs
        {
            Type = type, // Note: standard MouseEventArgs doesn't have Type field usually used this way, but our QueueMouse takes type string separately.
            ClientX = x, // QueueMouse likely uses OffsetX/Y logic or ClientX/Y mapping.
                         // TuiApp.InputManager probably expects ClientX/Y?
                         // Actually Blazor's MouseEventArgs OffsetX/Y are relative to target.
                         // ClientX/Y are relative to viewport.
                         // Our JS calculated x/y relative to container.
                         // If InputManager uses OffsetX, we should map x/y to it.
                         // Let's assume InputManager logic.
            // Wait, if InputManager uses ClientX/Y and subtracts Element rect?
            // If we pass x/y as ClientX/Y, InputManager might subtract AGAIN if it thinks it's global?
            // BUT: We passed relative X/Y from JS.
            // If InputManager expects relative X/Y in OffsetX/Y:
            OffsetX = x,
            OffsetY = y,
            Button = 0 // Assume Left
        };

        _app?.InputManager.QueueMouse(args, type);
    }

    public void Dispose()
    {
        _app?.Dispose();
        _objRef?.Dispose();
        // Invoke JS dispose? Dispose is sync, cannot await.
        // We really should use IAsyncDisposable.
        // But for sync Dispose we can try to fire and forget if possible, but unsafe.
    }
    
    public async ValueTask DisposeAsync()
    {
        try 
        {
            await JS.InvokeVoidAsync("tuiInterop.disposeResizeListener", CanvasId);
        }
        catch {}
        
        _app?.Dispose();
        _objRef?.Dispose();
    }
}
