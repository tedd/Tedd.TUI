@using Microsoft.JSInterop
@using Tedd.TUI
@using Tedd.TUI.Platform.Blazor
@using Tedd.TUI.Platform.Blazor.Components
@implements ITuiContainer
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@ContainerId" tabindex="0" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" @onmousedown='OnMouseDownInternal' style="outline:none; display: inline-block;">
    @if (Mode == TuiRenderMode.Canvas)
    {
        <canvas id="@CanvasId"></canvas>
    }
    else
    {
        <TuiDomGrid Renderer="@(_renderer as DomRenderer)" Width="@Width" Height="@Height" />
    }
</div>

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Width { get; set; } = 80;
    [Parameter] public int Height { get; set; } = 25;
    [Parameter] public TuiWindow? Window { get; set; }
    [Parameter] public TuiRenderMode Mode { get; set; } = TuiRenderMode.Canvas;

    public string CanvasId { get; } = "tui_c_" + Guid.NewGuid().ToString("N");
    public string ContainerId { get; } = "tui_v_" + Guid.NewGuid().ToString("N");

    private BlazorTuiApp? _app;
    private TuiWindow? _internalWindow;
    private IRendererAsync? _renderer;

    private TuiRenderMode _currentMode;
    private bool _modeChanged;

    public TuiWindow? CurrentWindow => Window ?? _internalWindow;

    protected override void OnInitialized()
    {
        if (Window == null)
        {
            _internalWindow = new TuiWindow();
        }
        _currentMode = Mode;
    }

    protected override void OnParametersSet()
    {
        if (Mode != _currentMode)
        {
            _currentMode = Mode;
            _modeChanged = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _modeChanged)
        {
            _modeChanged = false;
            await StartAppAsync();
            
            if (_objRef == null) _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tuiInterop.listenForResize", _objRef, CanvasId);
        }
    }

    private async Task StartAppAsync()
    {
        // Stop existing
        if (_app != null) 
        {
            _app.Dispose();
            _app = null;
        }

        var win = CurrentWindow;
        if (win != null)
        {
            if (Mode == TuiRenderMode.Canvas)
            {
                _renderer = new BlazorRenderer(JS, CanvasId);
            }
            else
            {
                _renderer = new DomRenderer(JS);
            }

            _app = new BlazorTuiApp(win, _renderer);
            await _app.StartAsync(Width, Height);
            
            // If DOM mode, we need to trigger a re-render to pass the renderer reference to TuiDomGrid
            if (Mode == TuiRenderMode.Dom)
            {
                StateHasChanged();
            }
        }
    }

    public void AddChild(UIElement child)
    {
        var win = CurrentWindow;
        if (win != null)
        {
            win.Content = child;
        }
    }
    
    [JSInvokable]
    public void OnBrowserResize(int cols, int rows)
    {
        if (Width != cols || Height != rows)
        {
            Width = cols;
            Height = rows;
            _app?.OnResize(cols, rows);
            StateHasChanged();
        }
    }

    private DotNetObjectReference<TuiView>? _objRef;

    private void OnKeyDown(KeyboardEventArgs e) => _app?.InputManager.QueueKey(e, true);
    private void OnKeyUp(KeyboardEventArgs e) => _app?.InputManager.QueueKey(e, false);
    
    private void OnMouseDownInternal(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Start global tracking for drag
        if (_objRef != null)
        {
            // Fire and forget or sync?
            // JS interop is async usually.
            // But we process this event now.
            JS.InvokeVoidAsync("tuiInterop.startGlobalDrag", _objRef, ContainerId);
        }
        _app?.InputManager.QueueMouse(e, "mousedown");
    }

    [JSInvokable]
    public void OnGlobalMouse(string type, double x, double y)
    {
        // Construct a MouseEventArgs manually
        // Note: Blazor's MouseEventArgs has many fields. We populate essential ones.
        // x and y are relative to container (thanks to JS logic).
        var args = new Microsoft.AspNetCore.Components.Web.MouseEventArgs
        {
            Type = type, // Note: standard MouseEventArgs doesn't have Type field usually used this way, but our QueueMouse takes type string separately.
            ClientX = x, // QueueMouse likely uses OffsetX/Y logic or ClientX/Y mapping.
                         // TuiApp.InputManager probably expects ClientX/Y?
                         // Actually Blazor's MouseEventArgs OffsetX/Y are relative to target.
                         // ClientX/Y are relative to viewport.
                         // Our JS calculated x/y relative to container.
                         // If InputManager uses OffsetX, we should map x/y to it.
                         // Let's assume InputManager logic.
            // Wait, if InputManager uses ClientX/Y and subtracts Element rect?
            // If we pass x/y as ClientX/Y, InputManager might subtract AGAIN if it thinks it's global?
            // BUT: We passed relative X/Y from JS.
            // If InputManager expects relative X/Y in OffsetX/Y:
            OffsetX = x,
            OffsetY = y,
            Button = 0 // Assume Left
        };

        _app?.InputManager.QueueMouse(args, type);
    }

    public void Dispose()
    {
        _app?.Dispose();
        _objRef?.Dispose();
        // Invoke JS dispose? Dispose is sync, cannot await.
        // We really should use IAsyncDisposable.
        // But for sync Dispose we can try to fire and forget if possible, but unsafe.
    }
    
    public async ValueTask DisposeAsync()
    {
        try 
        {
            await JS.InvokeVoidAsync("tuiInterop.disposeResizeListener", CanvasId);
        }
        catch {}
        
        _app?.Dispose();
        _objRef?.Dispose();
    }
}
